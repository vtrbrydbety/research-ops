# Copy to .env. Never commit real keys or invitation codes.
API_HOST=127.0.0.1
API_PORT=8000
RESEARCHOPS_DEPLOYMENT_MODE=public
RESEARCHOPS_PUBLIC_ORIGIN=https://researchops-agent.com
RESEARCHOPS_SECURITY_STORE_DIR=.runtime/security
# Local development only: explicitly set RESEARCHOPS_DEPLOYMENT_MODE=local.
# Local mode uses .runtime/security-local unless a different directory is specified.
RESEARCHOPS_LLM_PROVIDER=deepseek
RESEARCHOPS_LLM_BASE_URL=https://api.deepseek.com
RESEARCHOPS_LLM_API_KEY=
RESEARCHOPS_LLM_MODEL=deepseek-flash
RESEARCHOPS_LLM_MAX_OUTPUT_TOKENS=16384
# Other validated Settings fields use their uppercase field names.
EXECUTION_CONCURRENCY=2
EXECUTION_QUEUE_SIZE=4
INVITATION_DAILY_LIMIT=5
GLOBAL_DAILY_LIMIT=30
OPERATION_MODEL_ATTEMPTS=40
GLOBAL_DAILY_MODEL_ATTEMPTS=500
